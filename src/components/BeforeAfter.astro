---
import Img from './Img.astro';
/**
 * Drag to compare. The "after" photo sits on top, clipped by --split, and a
 * native range input drives it — keyboard, mouse and touch for free.
 */
interface Props {
  before: string;
  after: string;
  label?: string;
}
const {before, after, label = 'Compare before and after'} = Astro.props;
---
<div data-ba class="ba relative aspect-[16/10] w-full select-none overflow-hidden bg-steel" style="--split:50%">
  <Img name={before} sizes="(min-width: 1024px) 60vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-bottom" />
  <div class="after absolute inset-0">
    <Img name={after} sizes="(min-width: 1024px) 60vw, 100vw" class="h-full w-full object-cover object-bottom" />
  </div>
  <div class="handle pointer-events-none absolute inset-y-0 w-[3px] bg-orange" aria-hidden="true">
    <span class="absolute top-1/2 left-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-orange text-ink shadow-xl">
      <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6" /></svg>
    </span>
  </div>
  <span class="caps pointer-events-none absolute bottom-4 left-4 bg-ink/85 px-3 py-1.5 text-white">Before</span>
  <span class="caps pointer-events-none absolute right-4 bottom-4 bg-orange px-3 py-1.5 text-ink">After</span>
  <input type="range" min="0" max="100" value="50" aria-label={label} class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
</div>
<style>
  .after {
    clip-path: inset(0 0 0 var(--split));
  }
  .handle {
    left: calc(var(--split) - 1.5px);
  }
  .ba:has(input:focus-visible) {
    outline: 3px solid var(--color-hazard);
    outline-offset: 3px;
  }
</style>
