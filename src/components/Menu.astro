---
import {nav, site} from '../data/site';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!--
  The menu: three slabs wipe in from the right one after another (ink,
  Titan orange, paper); the paper slab stays and holds the links.
-->
<div id="site-menu" data-menu class="menu fixed inset-0 z-50" aria-hidden="true" inert>
  <svg class="absolute size-0" aria-hidden="true">
    <filter id="haze" x="-5%" y="-30%" width="110%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="2" seed="2" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <button type="button" data-menu-close tabindex="-1" aria-label="Close menu" class="scrim absolute inset-0 cursor-default bg-ink/50"></button>

  <div class="slab bg-ink" style="--k:0"></div>
  <div class="slab bg-orange" style="--k:1"></div>
  <nav class="slab flex flex-col justify-between overflow-y-auto bg-paper px-8 pt-24 pb-8 text-ink md:px-12" style="--k:2" aria-label="Main menu">
    <ul>
      {nav.map((item, i) => (
        <li class="item" style={`--i:${i}`}>
          <a
            href={item.href}
            data-menu-link
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="display relative inline-block py-1 text-[clamp(34px,4.2vh,50px)] transition-opacity duration-300 aria-[current=page]:text-rust"
          >
            {item.label}
            <sup class="caps absolute top-2 -right-7 text-[10px] tracking-normal text-ink/45">0{i + 1}</sup>
          </a>
        </li>
      ))}
    </ul>
    <div class="foot mt-10 space-y-5">
      <div class="flex flex-wrap gap-3">
        <a href={site.phoneHref} class="caps inline-flex min-h-12 items-center gap-2 bg-ink px-5 text-white hover:bg-orange hover:text-ink">
          <Icon name="phone" class="size-4" /> {site.phone}
        </a>
        <a href={site.whatsappHref} target="_blank" rel="noopener" class="caps inline-flex min-h-12 items-center gap-2 border-2 border-ink px-5 hover:bg-ink hover:text-white">
          <Icon name="whatsapp" class="size-4" /> WhatsApp
        </a>
      </div>
      <p class="caps text-ink/60">
        {site.city} ({site.cityAlt}) ·
        <a href={site.facebook} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-rust">Facebook</a>
      </p>
    </div>
  </nav>
</div>

<style>
  .slab {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: min(38vw, 540px);
    transform: translate3d(104%, 0, 0);
    transition: transform 0.8s var(--ease-wipe);
    /* Close: the reverse order, faster */
    transition-delay: calc((2 - var(--k)) * 0.06s);
  }
  @media (max-width: 767px) {
    .slab {
      width: 100%;
    }
  }
  .scrim {
    opacity: 0;
    transition: opacity 0.5s;
  }
  .item,
  .foot {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 0.7s var(--ease-silk),
      transform 0.7s var(--ease-silk);
  }
  .menu:not(.is-open) {
    pointer-events: none;
  }
  .menu.is-open .slab {
    transform: none;
    transition-delay: calc(var(--k) * 0.09s);
  }
  .menu.is-open .scrim {
    opacity: 1;
  }
  .menu.is-open .item {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.42s + var(--i) * 0.05s);
  }
  .menu.is-open .foot {
    opacity: 1;
    transform: none;
    transition-delay: 0.75s;
  }
  :global([data-menu-link].is-dim) {
    opacity: 0.35;
  }
  @media (prefers-reduced-motion: reduce) {
    .slab,
    .item,
    .foot {
      transition-duration: 0.01s;
      transition-delay: 0s !important;
    }
  }
</style>
