---
/** Shared template for the three section landing pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import {breadcrumbs, faqPage} from '../lib/schema';
import type {Entry, Faq as FaqT, Line, Section} from '../data/types';
import CtaBand from './CtaBand.astro';
import EntryCard from './EntryCard.astro';
import Faq from './Faq.astro';
import PageHero from './PageHero.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  lines: Line[];
  intro: string;
  image: string;
  section: {label: string; href: string};
  entries: Entry[];
  gridTitle: Line[];
  body: Section[];
  faqs: FaqT[];
}
const {title, description, eyebrow, lines, intro, image, section, entries, gridTitle, body, faqs} = Astro.props;
const siteUrl = Astro.site!;
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: section.label,
  itemListElement: entries.map((e, i) => ({'@type': 'ListItem', position: i + 1, name: e.name, url: new URL(`${section.href}${e.slug}/`, siteUrl).href})),
};
---
<BaseLayout title={title} description={description} image={image} schema={[breadcrumbs(siteUrl, [section]), list, faqPage(faqs)]}>
  <PageHero eyebrow={eyebrow} lines={lines} intro={intro} image={image} crumbs={[section]} />

  <section class="bg-ink py-20 md:py-28">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <h2 class="display mb-12 text-[clamp(48px,6.5vw,110px)]" data-reveal>
        {gridTitle.map((l) => <span class:list={['block', {it: l.i}]}>{l.t}</span>)}
      </h2>
      <div class="grid gap-[3px] sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((e, i) => <EntryCard entry={e} href={`${section.href}${e.slug}/`} index={i} />)}
      </div>
    </div>
  </section>

  <section class="on-paper bg-paper text-ink">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 py-20 md:px-14 md:py-28 lg:grid-cols-[1fr_minmax(0,760px)]">
      <p class="display text-[clamp(40px,4.5vw,72px)] lg:sticky lg:top-28 lg:self-start" data-reveal>
        <span class="block">The</span><span class="it block">details</span>
      </p>
      <article class="prose-titan">
        {body.map((s) => (
          <>
            <h2>{s.h}</h2>
            {s.p?.map((p) => <p set:html={p} />)}
            {s.list && <ul>{s.list.map((li) => <li set:html={li} />)}</ul>}
          </>
        ))}
      </article>
    </div>
  </section>

  <section class="on-paper bg-concrete text-ink">
    <div class="mx-auto grid max-w-[1680px] gap-12 px-5 py-20 md:px-14 md:py-28 lg:grid-cols-[1fr_2fr]">
      <h2 class="display text-[clamp(44px,5.5vw,88px)]" data-reveal><span class="block">{section.label}</span><span class="it block">FAQ</span></h2>
      <Faq faqs={faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
