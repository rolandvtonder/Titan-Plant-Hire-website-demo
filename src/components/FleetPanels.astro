---
import Icon from './Icon.astro';
import Img from './Img.astro';

/**
 * The fleet: tall panels slide in from the right one after another the
 * first time the section comes on screen (`.is-shown` from main.ts), and
 * their specs fade up once the last panel has landed.
 */
const panels = [
  {name: ['JCB 3CX', 'TLB'], img: 'tlb-jcb-3cx-front-loader', pos: '40% 50%', href: '/plant-hire/tlb-hire/', specs: [['Digs', 'Trenches & foundations'], ['Loads', 'Tippers & stockpiles']]},
  {name: ['JCB 135', 'Skid steer'], img: 'skid-steer-jcb-135-rear', pos: '45% 50%', href: '/plant-hire/skid-steer-hire/', specs: [['From', 'R2800 / day'], ['Includes', 'Driver & diesel']]},
  {name: ['Tipper', 'Trucks'], img: 'tipper-truck-sand-delivery', pos: '70% 50%', href: '/plant-hire/tipper-truck-hire/', specs: [['Carts', 'Rubble & soil'], ['Delivers', '7 ton sand & stone']]},
  {name: ['Water', 'Tanker'], img: 'water-tanker-side', pos: '35% 50%', href: '/plant-hire/water-tanker-hire/', specs: [['For', 'Dust & compaction'], ['Has', 'On-board pump']]},
];
---
<section id="fleet" data-panels class="fleet relative bg-ink" aria-labelledby="fleet-title">
  <div class="mx-auto flex max-w-[1680px] flex-col justify-between gap-6 px-5 pt-24 pb-10 md:flex-row md:items-end md:px-14">
    <h2 id="fleet-title" class="display text-[clamp(52px,7vw,120px)]" data-reveal>
      <span class="block">The fleet</span><span class="it block">ready to roll</span>
    </h2>
    <p class="max-w-md text-white/75" data-reveal style="--d:1">
      Our own JCB machines and Mercedes-Benz trucks, maintained in our yard and sent out with people who know them.
      <a href="/plant-hire/" class="mt-3 flex items-center gap-2 font-semibold text-orange hover:text-white">See all plant hire <Icon name="arrow" class="size-4" /></a>
    </p>
  </div>
  <div class="grid h-svh min-h-[640px] grid-cols-4 gap-[3px] overflow-hidden max-lg:h-auto max-lg:grid-cols-2 max-sm:grid-cols-1">
    {panels.map((p, i) => (
      <a href={p.href} class="panel group relative overflow-hidden bg-steel max-lg:h-[70svh] max-lg:min-h-[480px]" style={`--i:${i}`}>
        <Img name={p.img} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-silk group-hover:scale-105" alt="" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(14_14_14/0.75),transparent_45%,rgb(14_14_14/0.7))]"></div>
        <div class="relative flex h-full flex-col justify-between p-7 md:p-9">
          <h3 class="display text-[clamp(40px,3.6vw,64px)] text-white">
            <span class="block">{p.name[0]}</span>
            <span class="it block">{p.name[1]}</span>
          </h3>
          <div>
            <dl class="specs space-y-3">
              {p.specs.map(([k, v]) => (
                <div>
                  <dt class="caps text-white/65">{k}</dt>
                  <dd class="text-[18px] font-semibold text-white">{v}</dd>
                </div>
              ))}
            </dl>
            <span class="caps mt-6 inline-flex min-h-12 items-center gap-2 bg-white px-5 text-ink transition-colors group-hover:bg-orange">
              Hire it <Icon name="arrow" class="size-4" />
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .panel {
    transform: translate3d(calc(100% + 100vw), 0, 0);
    transition: transform 1.1s var(--ease-wipe);
    transition-delay: calc(0.12s + var(--i) * 0.14s);
  }
  .specs {
    opacity: 0;
    transition: opacity 0.7s 1.3s;
  }
  .fleet.is-shown .panel {
    transform: none;
  }
  .fleet.is-shown .specs {
    opacity: 1;
  }
  /* Without JS the panels simply sit in place */
  :global(html:not(.js)) .panel {
    transform: none;
  }
  :global(html:not(.js)) .specs {
    opacity: 1;
  }
</style>
