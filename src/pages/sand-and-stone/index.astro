  section={{label: 'Sand & stone', href: '/sand-and-stone/'}}
  entries={materials}
  gridTitle={[{t: 'Order your'}, {t: 'load', i: true}]}
  body={[
    {
      h: 'Sand and stone delivery in Port Elizabeth',
      p: [
        'Every building project starts with materials on site. Titan delivers <a href="/sand-and-stone/building-sand/">building sand</a> (from R1100 per 7 tons), <a href="/sand-and-stone/crusher-stone/">13mm and 19mm crusher stone</a> (from R1350 per 7 tons) and <a href="/sand-and-stone/grit/">grit</a> across Gqeberha and surrounds. Prices are “from” prices; the final price depends on your delivery address.',
