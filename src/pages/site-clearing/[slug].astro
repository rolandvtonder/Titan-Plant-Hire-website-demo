---
import DetailPage from '../../components/DetailPage.astro';
import {services} from '../../data/services';

export function getStaticPaths() {
  return services.map((entry) => ({params: {slug: entry.slug}, props: {entry}}));
}
const {entry} = Astro.props;
---
<DetailPage entry={entry} section={{label: 'Site clearing', href: '/site-clearing/'}} category="Site clearing" />
