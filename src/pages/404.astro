---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import {nav} from '../data/site';
---
<BaseLayout title="Page not found | Titan Plant Hire" description="This page could not be found." noindex>
  <section class="relative flex min-h-svh items-end overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <Img name="plot-clearing-before-bush" eager alt="" class="h-full w-full object-cover opacity-40" />
    </div>
    <div class="relative mx-auto w-full max-w-[1680px] px-5 pt-32 pb-28 md:px-14">
      <p class="caps text-orange">Error 404</p>
      <h1 class="display mt-4 text-[clamp(60px,10vw,180px)]"><span class="block">Nothing</span><span class="it block">dug up here</span></h1>
      <p class="mt-6 max-w-md text-[18px] text-white/80">This page has been cleared away. Try one of these instead:</p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {nav.map((n) => (
          <li><a href={n.href} class="caps inline-flex min-h-12 items-center gap-2 border border-white/25 px-5 hover:border-orange hover:text-orange">{n.label} <Icon name="arrow" class="size-4" /></a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
